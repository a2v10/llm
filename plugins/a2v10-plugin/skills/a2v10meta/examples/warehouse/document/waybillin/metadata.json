{
  "$schema": "../../@schemas/metadata-endpoint-json-schema.json#",
  "storage": "document",
  "autonum": "waybill",

  "initialValues": {
    "Date": { "source": "context", "value": "today" }
  },

  "rules": {
    "required": [ "Agent", "StoreTo" ]
  },

  "post": [
    {
      "journal":  "/journal/stock",
      "dir":      "in",
      "each":     { "details": "Rows" },
      "document": { "Store": "StoreTo" }
    }
  ],

  "forms": {
    "edit": {
      "is": "page",
      "body": [
        { "is": "group", "axis": "rows", "labelAt": "left", "fields": [ "Operation", "Number", "Date", "ExtNumber" ] },
        { "is": "group", "axis": "rows", "fields": [ "Agent", "StoreTo" ] },
        { "is": "tabs", "elements": [
          { "is": "tab", "scope": "Rows", "fields": [ "Item", "Unit", "VatRate", "Qty", "Price", "Sum" ] }
        ] },
        { "is": "group", "fields": [ "Total" ] }
      ]
    }
  }
}
