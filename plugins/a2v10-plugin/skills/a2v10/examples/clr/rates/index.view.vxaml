<Page xmlns="clr-namespace:A2v10.Xaml;assembly=A2v10.Xaml" Title="@[CurrencyRates]">
	<Grid Rows="Auto,1*" Height="100%">
		<Toolbar>
			<Button Icon="PlayOutline" Content="@[Rates.Load]"
					Command="{BindCmd Execute, CommandName=load}"/>
			<Separator />
			<Button Icon="Reload" Command="{BindCmd Reload}" />
		</Toolbar>
		<DataGrid ItemsSource="{Bind Rates}" FixedHeader="True" Sort="True">
			<DataGridColumn Header="@[Date]" Content="{Bind Date, DataType=Date}" Role="Date"/>
			<DataGridColumn Header="@[Code]" Content="{Bind Code}" Role="Fit"/>
			<DataGridColumn Header="@[Name]" Content="{Bind Name}"/>
			<DataGridColumn Header="@[Rate]" Content="{Bind Rate}" Align="Right" Role="Number"/>
		</DataGrid>
	</Grid>
</Page>
