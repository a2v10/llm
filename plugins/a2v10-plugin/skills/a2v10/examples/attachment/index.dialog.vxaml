<!-- Attachments of any record — opened as /attachment/index?base=<owner endpoint>, Argument = the owner -->
<Dialog xmlns="clr-namespace:A2v10.Xaml;assembly=A2v10.Xaml"
		Title="@[Attachments]" Width="60rem" Height="30rem">
	<Dialog.Buttons>
		<Button Content="@[Close]" Command="{BindCmd Close}"/>
	</Dialog.Buttons>
	<Grid Columns="20rem,1*" Rows="1*" Height="100%" AlignItems="Stretch">
		<Grid Rows="Auto,1*" Height="100%" AlignItems="Stretch">
			<Toolbar>
				<Button Icon="Upload" Content="@[Upload]" Command="{BindCmd Execute, CommandName=upload}"/>
				<Button Icon="Delete" Command="{BindCmd Execute, CommandName=remove, Argument={Bind Attachments.$selected}, Confirm='@[Confirm.Delete.Element]'}"/>
			</Toolbar>
			<List ItemsSource="{Bind Attachments}" AutoSelect="FirstItem">
				<ListItemSimple Content="{Bind Blob.Name}"/>
			</List>
		</Grid>
		<!-- Slot renders nothing while no item is selected; Fallback says why the space is empty -->
		<Slot Scope="{Bind Attachments.$selected}">
			<BlobPreview Value="{Bind Blob}" Height="100%"/>
			<Slot.Fallback>
				<EmptyPanel Content="@[Attachments.Empty]"/>
			</Slot.Fallback>
		</Slot>
	</Grid>
</Dialog>
